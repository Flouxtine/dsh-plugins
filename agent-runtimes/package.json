{
  "name": "@local/agent-runtimes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "One console for the mainstream agent runtimes on this machine — WorkBuddy, CodeBuddy CN, Codex/Codex++, Cursor and DeepSeek Harness — with approval reminders.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent",
    "runtime",
    "console",
    "monitor",
    "dashboard",
    "approval",
    "workbuddy",
    "codebuddy",
    "codex",
    "cursor"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Flouxtine/dsh-plugins.git",
    "directory": "agent-runtimes"
  },
  "homepage": "https://github.com/Flouxtine/dsh-plugins/tree/main/agent-runtimes#readme",
  "bugs": {
    "url": "https://github.com/Flouxtine/dsh-plugins/issues"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
